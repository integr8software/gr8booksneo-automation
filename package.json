{
  "name": "gr8booksneo-automation",
  "version": "2.0.0",
  "private": true,
  "description": "Centralized PR-focused QA automation toolkit for Gr8Books Neo.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check:madge": "madge --version",
    "check:knip": "knip --version",
    "check:playwright": "playwright --version",
    "check:semgrep": "semgrep --version",
    "verify:node-tools": "npm run check:madge && npm run check:knip && npm run check:playwright",
    "verify:tools": "npm run verify:node-tools && npm run check:semgrep",
    "knip": "knip --config configs/knip.json --reporter json --no-progress --no-config-hints",
    "madge": "madge --circular --json --extensions ts,tsx",
    "semgrep": "semgrep scan --config configs/semgrep.yml --json --quiet --metrics off",
    "smoke": "playwright test"
  },
  "keywords": [
    "gr8booksneo",
    "qa",
    "automation",
    "github-actions",
    "pull-request",
    "semgrep",
    "madge",
    "knip",
    "playwright",
    "static-analysis"
  ],
  "author": "Integr8 Software",
  "license": "UNLICENSED",
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.0",
    "knip": "^6.27.0",
    "madge": "^8.0.0",
    "typescript": "^5.9.3"
  }
}
