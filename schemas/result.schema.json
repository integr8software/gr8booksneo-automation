{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gr8booksneo.internal/schemas/result.schema.json",
  "title": "Gr8Books Neo PR Analysis Result",
  "description": "Standard normalized result generated by every PR-focused QA analyzer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "category",
    "status",
    "blocking",
    "exitCode",
    "findingCount",
    "durationMs",
    "summary",
    "details",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "SECURITY",
        "CIRCULAR_DEPENDENCIES",
        "UNUSED_CODE"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PASSED",
        "WARNING",
        "FAILED",
        "SKIPPED",
        "ERROR"
      ]
    },
    "blocking": {
      "type": "boolean"
    },
    "exitCode": {
      "type": "integer"
    },
    "findingCount": {
      "type": "integer",
      "minimum": 0
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "message",
          "file",
          "line",
          "ruleId"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "INFO",
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "ruleId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASSED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocking": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "WARNING"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocking": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SKIPPED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocking": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocking": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ERROR"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocking": {
            "const": true
          }
        }
      }
    }
  ]
}